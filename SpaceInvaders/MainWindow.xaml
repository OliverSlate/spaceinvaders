<Window x:Class="SpaceInvaders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpaceInvaders"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1600" Background="#FF051427" FontFamily="Resources/Fonts/#Pixel Digivolve">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F7000000" />
            <Setter Property="Foreground" Value="#FFF8BC04" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7101010" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#f7151515"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="MenuGrid">
            <Grid.Effect>
                <DropShadowEffect />
            </Grid.Effect>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="6*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="1" Grid.Row="1" FontSize="96" Foreground="#FFF8BC04">Space Invaders</TextBlock>
            <Button Grid.Column="1" Grid.Row="2" Width="400" Height="130" VerticalAlignment="Top"
                    FontSize="48" Content="PLAY" Style="{StaticResource MenuButtonStyle}" MouseEnter="Button_MouseEnter" Click="PlayButton_Click"/>
            <Button Grid.Column="1" Grid.Row="2" Width="400" Height="130" VerticalAlignment="Center"
                    FontSize="48" Content="OPTIONS" Style="{StaticResource MenuButtonStyle}" MouseEnter="Button_MouseEnter" Click="OptionsButton_Click"/>
            <Button Grid.Column="1" Grid.Row="2" Width="400" Height="130" VerticalAlignment="Bottom"
                    FontSize="48" Content="QUIT" Style="{StaticResource MenuButtonStyle}" MouseEnter="Button_MouseEnter" Click="QuitButton_Click"/>
            <Grid x:Name="OptionsGrid" Grid.Row="2" Grid.Column="2" Background="#f7000000" Visibility="Hidden"></Grid>
        </Grid>
        <Grid x:Name="GameGrid" Visibility="Hidden" />
        <Grid x:Name="LoseGrid" Visibility="Hidden" />
    </Grid>
</Window>