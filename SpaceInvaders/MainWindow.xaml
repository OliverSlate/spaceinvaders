<Window x:Class="SpaceInvaders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpaceInvaders"
        mc:Ignorable="d"
        Title="Space Invaders" Height="900" MinHeight="900" Width="1600" MinWidth="1600" Background="#FF051427" FontFamily="Resources/Fonts/#Pixel Digivolve">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F7000000" />
            <Setter Property="Foreground" Value="#FFF8BC04" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7101010" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#f7151515"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="MenuGrid" Visibility="Visible">
            <Grid.Effect>
                <DropShadowEffect />
            </Grid.Effect>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="6*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="2" Grid.Row="1" FontSize="96" Foreground="#FFF8BC04">Space Invaders</TextBlock>
            <Button Grid.Column="2" Grid.Row="2" Width="400" Height="130" VerticalAlignment="Top"
                    FontSize="48" Content="PLAY" Style="{StaticResource MenuButtonStyle}" MouseEnter="Button_MouseEnter" Click="PlayButton_Click"/>
            <Button Grid.Column="2" Grid.Row="2" Width="400" Height="130" VerticalAlignment="Center"
                    FontSize="48" Content="OPTIONS" Style="{StaticResource MenuButtonStyle}" MouseEnter="Button_MouseEnter" Click="OptionsButton_Click"/>
            <Button Grid.Column="2" Grid.Row="2" Width="400" Height="130" VerticalAlignment="Bottom"
                    FontSize="48" Content="QUIT" Style="{StaticResource MenuButtonStyle}" MouseEnter="Button_MouseEnter" Click="QuitButton_Click"/>
            <Grid x:Name="OptionsGrid" Grid.Row="2" Grid.Column="3" Background="#f7000000" Visibility="Hidden">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="3*"></RowDefinition>
                    <RowDefinition Height="3*"></RowDefinition>
                    <RowDefinition Height="3*"></RowDefinition>
                    <RowDefinition Height="2*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="1" Text="VOLUME" Foreground="#FFF8BC04" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Top"></TextBlock>
                <Slider x:Name="VolumeSlider" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Maximum="1" SmallChange="0.01" Value="1" TickFrequency="0.01" LargeChange="0.1"></Slider>
                <TextBlock x:Name="VolumeText" Grid.Row="1" Text="100%" Foreground="#FFF8BC04" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
                <TextBlock Grid.Row="2" Text="DEBUG" Foreground="#FFF8BC04" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Top"></TextBlock>
                <CheckBox x:Name="ForceBoss" Grid.Row="2" Foreground="#FFF8BC04" Content="FORCE BOSS WAVE" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,22">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
                <CheckBox x:Name="Invincible" Grid.Row="3" Foreground="#FFF8BC04" Content="INVINCIBLE" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
                <CheckBox x:Name="SuperSpeed" Grid.Row="3" Foreground="#FFF8BC04" Content="SUPER SPEED" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
                <CheckBox x:Name="FastAttack" Grid.Row="3" Foreground="#FFF8BC04" Content="FAST ATTACK" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
            </Grid>
        </Grid>
        <Grid x:Name="GameGrid" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="8*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock x:Name="WaveText" Grid.Column="1" Grid.Row="0" Foreground="#FFF8BC04" FontSize="48" Text="WAVE 0" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
            <TextBlock x:Name="ScoreText" Grid.Column="1" Grid.Row="0" Foreground="#FFF8BC04" FontSize="48" Text="SCORE 0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,18"></TextBlock>
            <TextBlock x:Name="MultiplierText" Grid.Column="1" Grid.Row="0" Foreground="#FFF8BC04" FontSize="24" Text="x1.0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"></TextBlock>
            <TextBlock x:Name="HighScoreText" Grid.Column="1" Grid.Row="0" Foreground="#FFF8BC04" FontSize="48" Text="HI 0" HorizontalAlignment="Right" VerticalAlignment="Center"></TextBlock>
            <Border BorderBrush="#FF1D1D1D" BorderThickness="2" Grid.Column="1" Grid.Row="1">
                <Canvas x:Name="GameCanvas"  Background="#000"></Canvas>
            </Border>
            <Grid x:Name="PowerUpGrid" Grid.Column="2" Grid.Row="1" Background="#000" VerticalAlignment="Top" HorizontalAlignment="Center" Width="180" Height="400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="2*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock  Grid.Row="0" Foreground="#FFF8BC04" FontSize="24" Text="POWERUPS" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            </Grid>
            <Canvas x:Name="HealthCanvas" Grid.Column="1" Grid.Row="2" Background="#000"></Canvas>
            <Grid x:Name="LoseGrid" Grid.Row="1" Grid.Column="1" Background="#66000000" Visibility="Hidden">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock  Foreground="#FFF8BC04" FontSize="72" HorizontalAlignment="Center" VerticalAlignment="Center">You Lose!</TextBlock>
                <Button Grid.Row="1" Width="400" Height="130" VerticalAlignment="Center"
                    FontSize="48" Content="MENU" Style="{StaticResource MenuButtonStyle}" MouseEnter="Button_MouseEnter" Click="MenuButton_Click"/>
                <Button Grid.Row="2" Width="400" Height="130" VerticalAlignment="Center"
                    FontSize="48" Content="RESTART" Style="{StaticResource MenuButtonStyle}" MouseEnter="Button_MouseEnter" Click="RestartButton_Click"/>
                <Button Grid.Row="3" Width="400" Height="130" VerticalAlignment="Center"
                    FontSize="48" Content="QUIT" Style="{StaticResource MenuButtonStyle}" MouseEnter="Button_MouseEnter" Click="QuitButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>